{
  "version": "1.0",
  "_doc": "保护规则（Protect.sys / SystemProtect.sys 共用，用户态内核同语义）：受保护对象清单。自我保护 + 系统关键位置。任何人触碰 => 拦截并通知（本产品自身操作经 ProcessProtect.sys PID 登记豁免）。",
  "rules": [
    {
      "id": "Protect_Ses_Product_Files",
      "kinds": ["FileDelete", "FileWrite", "FileModify", "ProcessOpen", "ProcessTerminate"],
      "glob": ["**\\sevenendpointsecurity\\**", "**\\sevenhips\\**", "**\\sevenedr\\**", "**\\sevenmain\\**", "**\\drvinstall\\**", "**\\engine\\**", "**\\enginers\\**", "**\\icon\\**"],
      "except_glob": ["*sevenhips*", "*sevenedr*", "*sevenmain*", "*drvinstall*", "*sevenengine*"],
      "action": "block",
      "score": 10,
      "severity": 100,
      "_note": "防卸载/防篡改：非本产品进程触碰产品文件/进程 => 拦截"
    },
    {
      "id": "Protect_System_Critical_Keys",
      "kinds": ["RegistryDelete", "RegistrySet"],
      "contains": [
        "\\currentversion\\run",
        "\\currentversion\\runonce",
        "\\currentversion\\image file execution options",
        "\\currentversion\\windows\\load",
        "\\currentversion\\policies\\system",
        "\\currentversion\\explorer\\shell folders",
        "system\\currentcontrolset\\services"
      ],
      "proc_glob": ["?:\\**\\cmd.exe", "?:\\**\\powershell.exe", "?:\\**\\wscript.exe", "?:\\**\\cscript.exe", "?:\\**\\mshta.exe", "?:\\**\\rundll32.exe"],
      "except_glob": ["?:\\windows\\system32\\**", "?:\\windows\\syswow64\\**", "*sevenendpointsecurity*"],
      "action": "block",
      "score": 10,
      "severity": 85,
      "_note": "解释器写/删系统关键注册表 => 拦截；常规安装器走 msiexec/setup 不在主体约束内，不受影响"
    },
    {
      "id": "Protect_Services_Tamper",
      "kinds": ["ServiceOp"],
      "contains": ["sevenprocessprotect", "sevenfile", "sevenendpoint", "sevenwatch", "sevensystemprotect", "sevenedr", "sevenprotect"],
      "except_glob": ["*sevenmain*", "*drvinstall*", "*sevenhips*", "*sevenedr*"],
      "action": "block",
      "score": 10,
      "severity": 100,
      "_note": "停/删本产品驱动服务 => 拦截"
    }
  ]
}
