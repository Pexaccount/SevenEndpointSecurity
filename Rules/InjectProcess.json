{
  "version": "1.0",
  "_doc": "注入规则（Files.txt：误报极高，所以默认只收以下两组零争议组合；其余注入一律由 EDR 评分观察）。正常进程约束见 except；White.json 命中先行放行。",
  "rules": [
    {
      "id": "Inject_Shellcode_Loader_To_Remote",
      "kinds": ["ProcessInject"],
      "proc_glob": ["?:\\**\\rundll32.exe", "?:\\**\\regsvr32.exe", "?:\\**\\mshta.exe", "?:\\**\\wscript.exe", "?:\\**\\cscript.exe"],
      "except_glob": ["?:\\program files\\**", "?:\\program files (x86)\\**", "?:\\windows\\system32\\**", "?:\\windows\\syswow64\\**"],
      "action": "block",
      "score": 10,
      "severity": 95,
      "_note": " LOLBIN 自身跨进程注入（极罕见于正常软件）—— 双重约束保零误报"
    },
    {
      "id": "Inject_Into_Self_Of_Product",
      "kinds": ["ProcessInject"],
      "proc_glob": ["**"],
      "contains": ["sevenhips", "sevenedr", "sevenmain", "sevenendpointsecurity", "drvinstall"],
      "action": "block",
      "score": 10,
      "severity": 100,
      "_note": "任何人注入本产品进程 —— 直接拦截并通知"
    }
  ]
}
